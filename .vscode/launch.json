{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "H753ZI: Debug RESPONDER",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/build/responder/UWBMico.elf",

            "servertype": "stlink",
            "device": "STM32H753ZITx",
            "interface": "swd",

            "serverpath": "${env:STM32CLT_Path}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer": "${env:STM32CLT_Path}/STM32CubeProgrammer/bin",
            "armToolchainPath": "${env:STM32CLT_Path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${env:STM32CLT_Path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverArgs": ["-i","0027001E3335510235383531"],

            "svdFile": "${env:STM32CLT_Path}/STMicroelectronics_CMSIS_SVD/STM32H753.svd",

            "runToEntryPoint": "main",
            "preLaunchTask": "UWB: Build Responder",                
            "showDevDebugOutput": "parsed"
        },
        {
            "name": "H753ZI: Debug INITIATOR",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/build/initiator/UWBMico.elf",

            "servertype": "stlink",
            "device": "STM32H753ZITx",
            "interface": "swd",

            "serverpath": "${env:STM32CLT_Path}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer": "${env:STM32CLT_Path}/STM32CubeProgrammer/bin",
            "armToolchainPath": "${env:STM32CLT_Path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${env:STM32CLT_Path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",
            "serverArgs": ["-i","0036002E3335510235383531"],

            "svdFile": "${env:STM32CLT_Path}/STMicroelectronics_CMSIS_SVD/STM32H753.svd",

            "runToEntryPoint": "main",
            "preLaunchTask": "UWB: Build Initiator",

            "showDevDebugOutput": "parsed"
        },
        {
            "name": "H753ZI: Attach",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/build/UWBMico.elf",

            "servertype": "stlink",
            "device": "STM32H753ZITx",
            "interface": "swd",

            "serverpath": "${env:STM32CLT_Path}/STLink-gdb-server/bin/ST-LINK_gdbserver.exe",
            "stm32cubeprogrammer": "${env:STM32CLT_Path}/STM32CubeProgrammer/bin",
            "armToolchainPath": "${env:STM32CLT_Path}/GNU-tools-for-STM32/bin",
            "gdbPath": "${env:STM32CLT_Path}/GNU-tools-for-STM32/bin/arm-none-eabi-gdb.exe",

            "svdFile": "${env:STM32CLT_Path}/STMicroelectronics_CMSIS_SVD/STM32H753.svd",

            "showDevDebugOutput": "parsed"
        }
    ]
}
