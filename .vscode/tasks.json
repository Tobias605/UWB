        {
            "label": "UWB: Configure Initiator",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "INITIATOR"
            ],
            "problemMatcher": []
        },
        {
            "label": "UWB: Build Initiator",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/initiator"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "UWB: Configure Responder",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "RESPONDER"
            ],
            "problemMatcher": []
        },
        {
            "label": "UWB: Build Responder",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/responder"
            ],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "STM32F401: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/cmake/gcc-arm-none-eabi.cmake"
            ],
            "problemMatcher": []
        },
        {
            "label": "H753ZI: Flash Initiator",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",       
                "sn=0036002E3335510235383531",
                "-w",
                "${workspaceFolder}/build/UWBMico.elf",
                "-v",
                "-rst"
            ],
            "dependsOn": "UWB: Build Initiator",
            "problemMatcher": []
        },
        {
            "label": "H753ZI: Flash Responder",
            "type": "shell",
            "command": "STM32_Programmer_CLI",
            "args": [
                "-c",
                "port=SWD",
                "mode=UR",    
                "sn=0027001E3335510235383531",
                "-w",
                "${workspaceFolder}/build/UWBMico.elf",
                "-v",
                "-rst"
            ],
            "dependsOn": "UWB: Build Responder",
            "problemMatcher": []
        }
    ]
}